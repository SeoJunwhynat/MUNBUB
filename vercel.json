{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "icn1"
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://matchunbeom-render.onrender.com/",
      "permanent": false
    },
    {
      "source": "/backrooms",
      "destination": "https://matchunbeom-render.onrender.com/backrooms/",
      "permanent": false
    },
    {
      "source": "/backrooms/",
      "destination": "https://matchunbeom-render.onrender.com/backrooms/",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "destination": "https://matchunbeom-render.onrender.com/",
      "permanent": false
    }
  ]
}
