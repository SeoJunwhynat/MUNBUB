{"spelling":[{"id":"s1","prompt":"병이 얼른 ___ 좋겠다.","options":["낳으면","나으면"],"answers":["나으면"],"note":"병이 좋아지는 것은 '낫다'이므로 '나으면'이 맞아."},{"id":"s2","prompt":"이 옷이 더 ___?","options":["문안하지","무난하지"],"answers":["무난하지"],"note":"평범하고 잘 어울린다는 뜻은 '무난하다'야."},{"id":"s3","prompt":"오늘은 ___ 숙제를 다 할 거야.","options":["반드시","반듯이"],"answers":["반드시"],"note":"'반드시'는 꼭, '반듯이'는 반듯한 모양을 뜻해."},{"id":"s4","prompt":"사소한 일인데도 사람들이 난리 ___을 피웠다.","options":["법석","법썩"],"answers":["법석"],"note":"'난리 법석'이 올바른 표기야."},{"id":"s5","prompt":"머리를 ___ 잘랐어.","options":["싹둑","싹뚝"],"answers":["싹둑"],"note":"무언가를 단번에 자르는 모양은 '싹둑'이야."},{"id":"s6","prompt":"___ 기억이 났어.","options":["언듯","언뜻"],"answers":["언뜻"],"note":"갑자기 잠깐 떠오르는 모양은 '언뜻'이야."},{"id":"s7","prompt":"식당에서 ___ 비빔밥을 주문했다.","options":["짭잘한","짭짤한"],"answers":["짭짤한"],"note":"'짭짤하다'가 올바른 표기야."},{"id":"s8","prompt":"어제 가족들과 함께 김치를 ___.","options":["담갔다","담궜다"],"answers":["담갔다"],"note":"'담그다'의 과거형은 '담갔다'야."},{"id":"s9","prompt":"급식 반찬으로 ___가 나왔다.","options":["깍뚝이","깍둑이","깍두기","깍뚜기"],"answers":["깍두기"],"note":"반찬의 이름은 '깍두기'야."},{"id":"s10","prompt":"국물을 진하게 만들려고 냄비에서 한참 ___.","options":["졸였다","조렸다"],"answers":["졸였다"],"note":"국물의 수분을 줄이면 '졸이다', 재료에 양념이 배게 하면 '조리다'야."},{"id":"s11","prompt":"할머니가 직접 ___ 대추차를 마셨다.","options":["달인","다린"],"answers":["달인"],"note":"약재 등을 끓여 우려내는 일은 '달이다'야."},{"id":"s12","prompt":"밀어도 다시 일어나는 ___를 가지고 놀았다.","options":["오뚝이","오뚜기"],"answers":["오뚝이"],"note":"'오뚝이'가 일반 명사 표준어야."},{"id":"s13","prompt":"___ 뒤에 다시 만나자.","options":["몇일","몇 일","며칠"],"answers":["며칠"],"note":"'며칠'은 하나의 단어로 적어."},{"id":"s14","prompt":"내가 가도 ___?","options":["돼","되"],"answers":["돼"],"note":"'돼'는 '되어'의 준말이야."},{"id":"s15","prompt":"지금 바로 시작하면 ___.","options":["돼요","되요"],"answers":["돼요"],"note":"'되어요'가 줄면 '돼요'야."},{"id":"s16","prompt":"그럼 내일 또 ___.","options":["봬요","뵈요"],"answers":["봬요"],"note":"'뵈어요'가 줄어든 형태는 '봬요'야."},{"id":"s17","prompt":"앞으로 모든 일이 잘 ___ 바란다.","options":["되길","돼길"],"answers":["되길"],"note":"'되기를'의 줄임 형태는 '되길'이야."},{"id":"s18","prompt":"우리 팀의 ___이 지난해보다 높아졌다.","options":["성공율","성공률"],"answers":["성공률"],"note":"받침이 있는 '성공' 뒤에는 '률'을 써."},{"id":"s19","prompt":"설문 조사 결과를 ___로 나타냈다.","options":["백분율","백분률"],"answers":["백분율"],"note":"'분'이 ㄴ 받침으로 끝나므로 '율'을 써."},{"id":"s20a","prompt":"아침에 세수하면서 눈에 낀 ___을 떼었다.","options":["눈곱","눈꼽"],"answers":["눈곱"],"note":"표준어는 '눈곱'이야."},{"id":"s20b","prompt":"아기가 자기 ___을 가리켰다.","options":["배곱","배꼽"],"answers":["배꼽"],"note":"표준어는 '배꼽'이야."},{"id":"s21","prompt":"실타래가 복잡하게 ___.","options":["얽히고설혔다","얽히고설켰다"],"answers":["얽히고설켰다"],"note":"표준 표현은 '얽히고설키다'야."},{"id":"s22","prompt":"점심에는 ___ 한 그릇을 먹었다.","options":["짜장면","자장면","쨔장면","자짱면"],"answers":["짜장면","자장면"],"note":"두 표기 모두 복수 표준어로 인정돼."},{"id":"s23","prompt":"‘느릿느릿 꾸물거리는 태도’를 뜻하는 표준어는? (둘 다 맞을 수도 있어.)","options":["늦장","늑장","늣장","늑짱"],"answers":["늦장","늑장"],"note":"'늦장'과 '늑장'은 모두 표준어로 인정되는 동의어야."},{"id":"s24","prompt":"오늘 발표는 이 그림으로 ___하겠습니다.","options":["갈음","가름"],"answers":["갈음"],"note":"'갈음하다'는 대신하다, '가름하다'는 구별하거나 판단하다야."},{"id":"s25","prompt":"이 일을 마치려면 ___ 한 시간은 걸리겠다.","options":["겉잡아서","걷잡아서"],"answers":["겉잡아서"],"note":"'겉잡다'는 겉으로 대강 짐작한다는 뜻이야."},{"id":"s26","prompt":"구름 사이로 ___이 얼굴을 내밀었다.","options":["해님","햇님"],"answers":["해님"],"note":"'해님'은 사이시옷을 넣지 않아."},{"id":"s27","prompt":"운동을 시작한 지 ___로 벌써 오 년이 지났다.","options":["해수","햇수"],"answers":["햇수"],"note":"해의 수를 뜻하는 말은 '햇수'야."},{"id":"s28a","prompt":"이사를 앞두고 작은 ___을 알아보았다.","options":["전세방","전셋방"],"answers":["전세방"],"note":"국립국어원: ‘전세방’은 한자어 ‘전세’와 ‘방’의 결합이므로 사이시옷을 쓰지 않아. ‘전셋집’과 ‘셋방’은 별개의 표기야."},{"id":"s28b","prompt":"부모님은 교외에 ___을 구하셨다.","options":["전세집","전셋집"],"answers":["전셋집"],"note":"표준 표기는 '전셋집'이야."},{"id":"s28c","prompt":"나는 학교 근처에 작은 ___을 얻었다.","options":["세방","셋방"],"answers":["셋방"],"note":"표준 표기는 '셋방'이야."},{"id":"s29","prompt":"처음 만난 친구에게 반갑게 ___을 건넸다.","options":["인사말","인삿말"],"answers":["인사말"],"note":"'인사말'에는 사이시옷을 쓰지 않아."},{"id":"s30","prompt":"어른에게는 공손하게 ___을 사용해야 한다.","options":["존대말","존댓말"],"answers":["존댓말"],"note":"표준 표기는 '존댓말'이야."},{"id":"s31","prompt":"축제가 끝난 뒤 친구들과 ___를 했다.","options":["뒤풀이","뒷풀이"],"answers":["뒤풀이"],"note":"표준 표기는 '뒤풀이'야."},{"id":"s32","prompt":"저녁 하늘이 ___으로 물들었다.","options":["오렌지빛","오렌짓빛"],"answers":["오렌지빛"],"note":"외래어 '오렌지' 뒤에는 사이시옷을 넣지 않아."},{"id":"s33","prompt":"___, 고작 이거야?","options":["에계","에개"],"answers":["에계"],"note":"하찮게 보며 내는 감탄사는 '에계'야. '애걔'도 표준어야."},{"id":"s34","prompt":"나무가 ___ 뻗어 있었다.","options":["멋드러지게","멋들어지게"],"answers":["멋들어지게"],"note":"매우 멋이 있다는 뜻은 '멋들어지다'야."},{"id":"s35","prompt":"그곳에서는 ___ 이상한 소리가 들렸다.","options":["간간이","간간히"],"answers":["간간이"],"note":"때때로라는 뜻은 '간간이'야."},{"id":"s36","prompt":"나도 ___ 생각해 봤어.","options":["곰곰이","곰곰히"],"answers":["곰곰이"],"note":"깊이 생각하는 모양은 '곰곰이'야."},{"id":"s37","prompt":"교실을 ___ 정리하고 가자.","options":["깨끗이","깨끗히"],"answers":["깨끗이"],"note":"'-하다'로 끝나는 말이라도 '깨끗이'가 맞아."},{"id":"s38","prompt":"___ 공부하는 습관을 들이자.","options":["틈틈이","틈틈히"],"answers":["틈틈이"],"note":"틈이 날 때마다를 뜻하는 '틈틈이'야."},{"id":"s39","prompt":"그는 위험을 무릅쓰는 일도 ___ 않았다.","options":["서슴지","서슴치"],"answers":["서슴지"],"note":"주저하지 않는다는 뜻은 '서슴지 않다'야."},{"id":"s40","prompt":"그건 앞뒤가 맞지 ___!","options":["안잖아","않잖아"],"answers":["않잖아"],"note":"'맞지 않다'에 '-잖아'가 붙으므로 '않잖아'야."},{"id":"s41","prompt":"아이들이 ___ 운동장에서 뛰어놀았다.","options":["널찍한","넓직한"],"answers":["널찍한"],"note":"'널찍하다'가 표준어야."},{"id":"s42","prompt":"그는 ___ 독서의 중요성을 깨달았다.","options":["일찍이","일찌기"],"answers":["일찍이"],"note":"'일찍이'가 바른 표기야."},{"id":"s43","prompt":"친구가 많이 아프다니, ___?","options":["어떻게","어떡해"],"answers":["어떡해"],"note":"'어떡해'는 '어떻게 해'가 줄어든 말이야."},{"id":"s44","prompt":"오늘은 ___ 기분이 이상해.","options":["왠지","웬지"],"answers":["왠지"],"note":"'왜인지'가 줄어든 말은 '왠지'야."},{"id":"s45","prompt":"___ 연락이 안 된다.","options":["웬일인지","왠일인지"],"answers":["웬일인지"],"note":"무슨 일인지라는 뜻은 '웬일인지'야."},{"id":"s46","prompt":"마지막 퀴즈에서 정답을 정확히 ___.","options":["맞혔다","맞췄다"],"answers":["맞혔다"],"note":"정답을 알아내면 '맞히다'야."},{"id":"s47","prompt":"두 시계의 시간을 똑같이 ___.","options":["맞혔다","맞췄다"],"answers":["맞췄다"],"note":"정렬하거나 가지런하게 하면 '맞추다'야."},{"id":"s48","prompt":"그 선수는 화살로 과녁을 ___.","options":["맞혔다","맞췄다"],"answers":["맞혔다"],"note":"과녁에 적중시키면 '맞히다'야."},{"id":"s49","prompt":"의사는 아이에게 예방 주사를 ___.","options":["맞혔다","맞췄다"],"answers":["맞혔다"],"note":"예방주사를 받도록 하면 '맞히다'야."},{"id":"s50","prompt":"그는 나를 ___ 쳐다봤다.","options":["지그시","지긋이"],"answers":["지그시"],"note":"슬며시 힘을 주거나 오래 바라보는 모습은 '지그시'야."},{"id":"s51","prompt":"연세가 ___ 드신 분이 인사하셨다.","options":["지그시","지긋이"],"answers":["지긋이"],"note":"나이가 비교적 많다는 뜻은 '지긋이'야."},{"id":"s52","prompt":"액자를 ___ 놓아두었다.","options":["반드시","반듯이"],"answers":["반듯이"],"note":"똑바르고 가지런한 모양을 뜻해."},{"id":"s53","prompt":"학생이 가방을 어깨에 ___.","options":["매었다","메었다"],"answers":["메었다"],"note":"가방을 어깨에 걸치면 '메다'야."},{"id":"s54","prompt":"나는 신발 끈을 단단히 ___.","options":["매었다","메었다"],"answers":["매었다"],"note":"끈을 묶으면 '매다'야."},{"id":"s55","prompt":"그는 자꾸 친구의 화를 ___.","options":["돋웠다","돋궜다"],"answers":["돋웠다"],"note":"화를 더 일어나게 하는 것은 '돋우다'야."},{"id":"s56","prompt":"시험공부를 하느라 밤을 ___.","options":["새웠다","세웠다"],"answers":["새웠다"],"note":"잠을 자지 않고 밤을 보내면 '새우다'야."},{"id":"s57","prompt":"우리 동네에 새 도서관을 ___.","options":["새웠다","세웠다"],"answers":["세웠다"],"note":"건축하거나 똑바로 일으키면 '세우다'야."},{"id":"s58","prompt":"나에게는 꼭 이루고 싶은 한 가지 ___이 있다.","options":["바람","바램"],"answers":["바람"],"note":"원하는 마음은 '바람'이야."},{"id":"s59","prompt":"나는 네가 꼭 합격하기를 ___.","options":["바래","바라"],"answers":["바라"],"note":"'바라다'의 활용형은 '바라'야."},{"id":"s60","prompt":"길가에 작은 ___가 굴러다녔다.","options":["돌맹이","돌멩이"],"answers":["돌멩이"],"note":"표준어는 '돌멩이'야."},{"id":"s61","prompt":"그 말을 듣고 ___가 떨어졌다.","options":["정나미","정내미"],"answers":["정나미"],"note":"사람에 대한 정을 속되게 이르는 말은 '정나미'야."},{"id":"s62","prompt":"___ 굴지 마.","options":["째째하게","쩨쩨하게"],"answers":["쩨쩨하게"],"note":"'쩨쩨하다'가 표준어야."},{"id":"s63","prompt":"나는 ___에 이 학교로 전학 왔다.","options":["재작년","제작년"],"answers":["재작년"],"note":"표준어는 '재작년'이야."},{"id":"s64","prompt":"심심해서 게임을 하며 시간을 ___.","options":["때웠다","떼웠다"],"answers":["때웠다"],"note":"시간을 보내는 것은 '때우다'야."},{"id":"s65","prompt":"고기 냄새가 옷에 ___.","options":["배었다","베었다"],"answers":["배었다"],"note":"냄새가 스며드는 것은 '배다'야."},{"id":"s66","prompt":"비가 내리더니 ___ 그쳤다.","options":["금새","금세"],"answers":["금세"],"note":"'금시에'의 준말은 '금세'야."},{"id":"s67","prompt":"___는 저녁마다 산책을 한다.","options":["요새","요세"],"answers":["요새"],"note":"표준어는 '요새'야."},{"id":"s68","prompt":"아버지가 마당의 잔디를 ___.","options":["깍았다","깎았다"],"answers":["깎았다"],"note":"깎아 다듬는 것은 '깎다'야."},{"id":"s69","prompt":"신발에 흙이 ___.","options":["묻었다","뭍었다"],"answers":["묻었다"],"note":"가루나 액체가 달라붙는 것은 '묻다'야."},{"id":"s70","prompt":"그는 귀중품을 땅에 ___.","options":["묻었다","뭍었다"],"answers":["묻었다"],"note":"땅속에 넣는 것도 '묻다'야."},{"id":"s71","prompt":"모르는 내용은 선생님께 ___.","options":["묻는다","문다"],"answers":["묻는다"],"note":"질문하는 것은 '묻다'야."},{"id":"s72a","prompt":"나는 점심으로 얼큰한 ___을 먹었다.","options":["육계장","육개장"],"answers":["육개장"],"note":"표준어는 '육개장'이야."},{"id":"s72b","prompt":"어제 저녁에는 닭고기가 든 ___을 끓였다.","options":["닭계장","닭개장"],"answers":["닭개장"],"note":"표준어는 '닭개장'이야."},{"id":"s73","prompt":"잠잘 때 머리 밑에 ___를 받쳤다.","options":["베개","배게"],"answers":["베개"],"note":"표준어는 '베개'야."},{"id":"s74","prompt":"오늘 저녁에는 된장___를 끓였다.","options":["찌개","찌게"],"answers":["찌개"],"note":"표준어는 '찌개'야."},{"id":"s75","prompt":"저는 ___.","options":["학생이에요","학생이예요"],"answers":["학생이에요"],"note":"받침이 있는 '학생' 뒤에는 '이에요'야."},{"id":"s76","prompt":"그 사람은 ___.","options":["바보에요","바보예요"],"answers":["바보예요"],"note":"받침 없는 '바보' 뒤에는 '예요'야."},{"id":"s77","prompt":"그건 ___.","options":["아니에요","아니예요"],"answers":["아니에요"],"note":"'아니에요'가 맞는 표현이야."},{"id":"s78","prompt":"진작에 와 ___!","options":["볼걸","볼껄"],"answers":["볼걸"],"note":"후회의 뜻을 나타내는 어미는 '-ㄹ걸'이야."},{"id":"s79","prompt":"시험을 ___.","options":["치렀습니다","치뤘습니다"],"answers":["치렀습니다"],"note":"'치르다'는 '치러, 치렀다'로 활용해."},{"id":"s80","prompt":"문을 ___ 주세요.","options":["잠가","잠궈"],"answers":["잠가"],"note":"'잠그다'의 활용형은 '잠가'야."},{"id":"s81","prompt":"친구를 ___ 만났다.","options":["오랫만에","오랜만에"],"answers":["오랜만에"],"note":"'오랜만'이 하나의 단어야."},{"id":"s82","prompt":"체력이 ___ 더 못 뛰겠어.","options":["달려서","딸려서"],"answers":["달려서"],"note":"힘이나 능력이 부족한 것은 '달리다'야."},{"id":"s83","prompt":"부모님은 가족들을 돌보느라 온갖 ___를 하셨다.","options":["뒤치다꺼리","뒤치닥거리"],"answers":["뒤치다꺼리"],"note":"표준어는 '뒤치다꺼리'야."},{"id":"s84","prompt":"그는 혼자서 불만을 ___.","options":["구시렁거렸다","궁시렁거렸다"],"answers":["구시렁거렸다"],"note":"'구시렁거리다'가 표준어야."},{"id":"s85","prompt":"‘얼마만큼’의 올바른 준말은?","options":["얼만큼","얼마큼"],"answers":["얼마큼"],"note":"'얼마큼'은 '얼마만큼'의 올바른 준말이야. '얼만큼'은 잘못된 표기야."},{"id":"s86","prompt":"그는 설명을 ___하게 얼버무렸다.","options":["두리뭉실","두루뭉술","두루뭉실","두리뭉술"],"answers":["두리뭉실","두루뭉술"],"note":"둘 다 표준 표현으로 인정돼."},{"id":"s87","prompt":"약속이 흐지부지되어 ___가 났어.","options":["파토","파투"],"answers":["파투"],"note":"일이 잘못되어 흐지부지됨은 '파투'야."},{"id":"s88","prompt":"저녁 식사 후 내가 ___를 맡았다.","options":["설거지","설겆이"],"answers":["설거지"],"note":"표준어는 '설거지'야."},{"id":"s89","prompt":"아이는 ___ 얼굴로 웃었다.","options":["앳된","애띤"],"answers":["앳된"],"note":"나이에 비해 어려 보이는 얼굴은 '앳된 얼굴'이야."},{"id":"s90","prompt":"야, ___!","options":["임마","인마"],"answers":["인마"],"note":"'이놈아'가 줄어든 말은 '인마'야."},{"id":"s91","prompt":"첫 데이트를 앞두니 가슴에 ___이 가득했다.","options":["설레임","설렘"],"answers":["설렘"],"note":"'설레다'의 명사형은 '설렘'이야."},{"id":"s92","prompt":"남의 물건을 ___ 다루면 안 된다.","options":["허투루","허트루"],"answers":["허투루"],"note":"아무렇게나 대충은 '허투루'야."},{"id":"s93","prompt":"그 이야기는 정말 ___하다.","options":["황당무계","황당무개"],"answers":["황당무계"],"note":"'황당무계'는 말이나 일이 터무니없다는 뜻이야."},{"id":"s94","prompt":"친구에게 ___ 물어보았다.","options":["넌지시","넌즈시"],"answers":["넌지시"],"note":"모르게 슬쩍은 '넌지시'야."},{"id":"s95","prompt":"과일을 ___ 먹었다.","options":["껍질째","껍질채"],"answers":["껍질째"],"note":"'째'는 그대로의 상태를 뜻하는 접미사야."},{"id":"s96","prompt":"___ 공부할 나이다.","options":["한참","한창"],"answers":["한창"],"note":"활동이 가장 활발한 때는 '한창'이야."},{"id":"s97","prompt":"길을 잃은 그는 한동안 ___.","options":["어리버리했다","어리바리했다"],"answers":["어리바리했다"],"note":"표준어는 '어리바리하다'야."},{"id":"s98","prompt":"선배는 일을 빨리 끝내라고 후배를 ___.","options":["닦달했다","닥달했다"],"answers":["닦달했다"],"note":"몰아세워 단단히 요구하는 것은 '닦달하다'야."},{"id":"s99","prompt":"너 지금 ___ 그런 소리를 하는 거야?","options":["어따대고","얻다 대고"],"answers":["얻다 대고"],"note":"'어디에다 대고'의 준말은 '얻다 대고'야."},{"id":"s100","prompt":"그는 선생님의 조언을 여러 번 ___.","options":["곱씹었다","곱십었다"],"answers":["곱씹었다"],"note":"되풀이하여 생각하는 것은 '곱씹다'야."},{"id":"s101","prompt":"그는 반대에도 불구하고 계획을 끝까지 ___.","options":["밀어부쳤다","밀어붙였다"],"answers":["밀어붙였다"],"note":"표준 표기는 '밀어붙이다'야."},{"id":"s102","prompt":"그는 친구에게 편지를 ___.","options":["부쳤다","붙였다"],"answers":["부쳤다"],"note":"편지를 보내는 것은 '부치다'야."},{"id":"s103","prompt":"땅에 ___을 꿇었다.","options":["무릎","무릅"],"answers":["무릎"],"note":"표준어는 '무릎'이야."},{"id":"s104","prompt":"남의 일에 지나치게 참견하는 사람은 ___이 넓다고 한다.","options":["오지랖","오지랍"],"answers":["오지랖"],"note":"표준어는 '오지랖'이야."},{"id":"s105","prompt":"교실 책상을 새것으로 ___하였다.","options":["갈음","가름"],"answers":["갈음"],"note":"다른 것으로 대신한다는 뜻은 '갈음하다'야."},{"id":"s106","prompt":"수리비는 ___ 십만 원 정도 든다.","options":["걷잡아서","겉잡아서"],"answers":["겉잡아서"],"note":"대강 짐작하면 '겉잡아서'야."},{"id":"s107","prompt":"눈물이 ___ 수 없이 흘러내렸다.","options":["걷잡을","겉잡을"],"answers":["걷잡을"],"note":"감당하거나 제어할 수 없다는 뜻은 '걷잡다'야."},{"id":"s108","prompt":"친구에게 속상한 마음을 털어놓으며 ___를 늘어놓았다.","options":["넉두리","넋두리"],"answers":["넋두리"],"note":"표준어는 '넋두리'야."},{"id":"s109","prompt":"___ 오늘은 여기까지만 하자.","options":["아무튼","아뭏든"],"answers":["아무튼"],"note":"표준어는 '아무튼'이야."},{"id":"s110","prompt":"___ 결과는 좋았다.","options":["어쨌든","어쨋든"],"answers":["어쨌든"],"note":"표준어는 '어쨌든'이야."},{"id":"s111","prompt":"부모님 속을 ___ 마라.","options":["썩이지","썩히지"],"answers":["썩이지"],"note":"속을 상하게 하는 것은 '속을 썩이다'야."},{"id":"s112","prompt":"서민 경제를 ___ 것이다.","options":["결단낸","결딴낸"],"answers":["결딴낸"],"note":"완전히 망가뜨리는 것은 '결딴내다'야."},{"id":"s113","prompt":"그는 자신의 신념을 ___ 행동했다.","options":["좇아","쫓아"],"answers":["좇아"],"note":"목표·원칙을 따르는 것은 '좇다', 뒤따라가는 것은 '쫓다'야."},{"id":"s114","prompt":"공원에서는 흡연을 ___ 주세요.","options":["삼가해","삼가"],"answers":["삼가"],"note":"'삼가다'의 활용형은 '삼가'야."},{"id":"s115","prompt":"그런 실수를 하다니 정말 ___.","options":["어의없다","어이없다"],"answers":["어이없다"],"note":"너무 뜻밖이라 기가 막히면 '어이없다'야."},{"id":"s116","prompt":"나는 동생에게 수학을 ___.","options":["가르쳤다","가리켰다"],"answers":["가르쳤다"],"note":"지식을 알려 주는 것은 '가르치다'야."},{"id":"s117","prompt":"신용 카드 ___이 내일이다.","options":["결제일","결재일"],"answers":["결제일"],"note":"돈을 치르는 일은 '결제'야."},{"id":"s118","prompt":"부장님께 ___받을 서류가 있어.","options":["결제","결재"],"answers":["결재"],"note":"상급자의 승인을 받는 일은 '결재'야."},{"id":"s119","prompt":"상황이 정말 ___.","options":["희안하다","희한하다"],"answers":["희한하다"],"note":"'희한하다'가 표준어야."},{"id":"s120","prompt":"너를 ___ 믿었는데.","options":["철석같이","철썩같이"],"answers":["철석같이"],"note":"아주 굳고 단단하게는 '철석같이'야."},{"id":"s121","prompt":"사고 후 오랫동안 ___이 남았다.","options":["후유증","휴유증"],"answers":["후유증"],"note":"표준어는 '후유증'이야."},{"id":"s122","prompt":"결혼식 ___을 냈다.","options":["부조금","부주금"],"answers":["부조금"],"note":"표준 표기는 '부조금'이야."},{"id":"s123","prompt":"___ 그럴 필요 있어?","options":["굳이","구지"],"answers":["굳이"],"note":"억지로 기어이란 뜻은 '굳이'야."},{"id":"s124","prompt":"그는 그녀와 진지하게 ___를 시작했다.","options":["연애","연예"],"answers":["연애"],"note":"서로 좋아하며 사귀는 것은 '연애'야."},{"id":"s125","prompt":"그 배우는 유명한 ___이다.","options":["연예인","연애인"],"answers":["연예인"],"note":"표준어는 '연예인'이야."},{"id":"s126","prompt":"이것은 학생들에게도 ___ 문제다.","options":["고난이도","고난도"],"answers":["고난도"],"note":"어려움의 정도가 높은 것은 '고난도'라고 해."},{"id":"s127","prompt":"준비 없이 시험을 보면 실패하기 ___.","options":["십상이다","쉽상이다"],"answers":["십상이다"],"note":"상황에 꼭 들어맞는 것은 '십상이다'야."},{"id":"s128","prompt":"불안하더니 결국 큰 ___이 났군.","options":["사단","사달"],"answers":["사달"],"note":"뜻밖에 생긴 좋지 않은 일을 '사달'이라고 해."},{"id":"s129","prompt":"___ 같은 박수가 터졌다.","options":["우레","우뢰"],"answers":["우레"],"note":"천둥소리의 표준어는 '우레'야."},{"id":"s130","prompt":"그건 ___ 전문가도 어렵다.","options":["내로라하는","내노라하는"],"answers":["내로라하는"],"note":"어떤 분야의 대표격임을 뜻하는 말은 '내로라하는'이야."},{"id":"s131","prompt":"우리는 평등을 ___한다.","options":["지양","지향"],"answers":["지향"],"note":"목표로 삼아 향하는 것은 '지향하다'야."},{"id":"s132","prompt":"그가 나를 ___ 나도 그를 믿는다.","options":["믿으므로","믿음으로"],"answers":["믿으므로"],"note":"이유를 나타내는 연결 어미는 '-으므로'야."},{"id":"s133","prompt":"너와 나는 서로 ___.","options":["다르다","틀리다"],"answers":["다르다"],"note":"같지 않다는 뜻은 '다르다', 맞지 않다는 뜻은 '틀리다'야."},{"id":"s134","prompt":"그 일을 ___ 네 마음대로 해.","options":["하든지 말든지","하던지 말던지"],"answers":["하든지 말든지"],"note":"선택을 나타내면 '-든지'를 써."},{"id":"s135","prompt":"내가 ___ 아이를 지켜야지.","options":["엄마로서","엄마로써"],"answers":["엄마로서"],"note":"자격이나 지위를 나타내면 '-로서'야."},{"id":"s136","prompt":"집에 ___ 전화할게.","options":["도착하는 대로","도착하는 데로"],"answers":["도착하는 대로"],"note":"어떤 일이 일어난 즉시를 뜻하는 '대로'야."},{"id":"s137a","prompt":"이건 나만 아는 비밀인___.","options":["대","데"],"answers":["데"],"note":"'비밀인데'는 '-ㄴ데'를 붙여 쓰는 표현이야."},{"id":"s137b","prompt":"둘이 사귄___.","options":["대","데"],"answers":["대"],"note":"남에게 들은 말을 전하면 '-대'를 써."},{"id":"s138","prompt":"___ 수업이 끝나면 만나자.","options":["있다가","이따가"],"answers":["이따가"],"note":"조금 후에라는 뜻은 '이따가'야."},{"id":"s139","prompt":"모든 것이 ___ 났다.","options":["풍비박산","풍지박산"],"answers":["풍비박산"],"note":"사방으로 뿔뿔이 흩어지는 것은 '풍비박산'이야."},{"id":"s140","prompt":"그는 ___의 위기에 놓였다.","options":["절체절명","절대절명"],"answers":["절체절명"],"note":"몸과 목숨에 관계된 매우 위급한 상황은 '절체절명'이야."},{"id":"s141","prompt":"두 사람은 ___하며 지냈다.","options":["동고동락","동거동락"],"answers":["동고동락"],"note":"괴로움과 즐거움을 함께하는 것은 '동고동락'이야."},{"id":"s142","prompt":"그는 ___을 자세히 설명했다.","options":["자초지종","자초지정"],"answers":["자초지종"],"note":"일의 시작부터 끝까지 경과는 '자초지종'이야."},{"id":"s143","prompt":"___ 화면을 저장했다.","options":["캡쳐","캡처"],"answers":["캡처"],"note":"외래어 표기법에 따른 표기는 '캡처'야."},{"id":"s144","prompt":"그 식당의 ___가 직접 요리해 주었다.","options":["셰프","쉐프"],"answers":["셰프"],"note":"외래어 표기는 '셰프'야."},{"id":"s145","prompt":"그 아이는 ___ 인형을 좋아한다.","options":["슈퍼맨","수퍼맨"],"answers":["슈퍼맨"],"note":"외래어 표기는 '슈퍼맨'이야."},{"id":"s146a","prompt":"달걀을 굽기 위해 ___을 꺼냈다.","options":["프라이팬","후라이팬"],"answers":["프라이팬"],"note":"외래어 표기는 '프라이팬'이야."},{"id":"s146b","prompt":"응원단이 큰 소리로 ___을 외쳤다.","options":["파이팅","화이팅"],"answers":["파이팅"],"note":"외래어 표기는 '파이팅'이야."},{"id":"s147","prompt":"운전할 때 ___의 안내를 따랐다.","options":["내비게이션","네비게이션"],"answers":["내비게이션"],"note":"외래어 표기는 '내비게이션'이야."},{"id":"s148","prompt":"생일에 ___를 나눠 먹었다.","options":["케잌","케익","케이크"],"answers":["케이크"],"note":"외래어 표기는 '케이크'야."},{"id":"s149","prompt":"휴양지에서 ___을 즐겼다.","options":["스노쿨링","스노클링"],"answers":["스노클링"],"note":"표준 외래어 표기는 '스노클링'이야."},{"id":"s150","prompt":"훌륭한 ___을 발휘했다.","options":["리더쉽","리더십"],"answers":["리더십"],"note":"외래어 표기는 '리더십'이야."}],"idioms":[{"id":"i001","meaning":"가혹하게 세금을 거두거나 백성의 재물을 억지로 빼앗음","answer":"가렴주구"},{"id":"i002","meaning":"뼈에 사무치도록 마음속 깊이 맺힌 원한","answer":"각골통한"},{"id":"i003","meaning":"남의 비위에 맞도록 꾸민 달콤한 말과 이로운 조건을 내세워 꾀는 말","answer":"감언이설"},{"id":"i004","meaning":"달면 삼키고 쓰면 뱉듯, 자기 비위에 맞으면 취하고 싫으면 버림","answer":"감탄고토"},{"id":"i005","meaning":"서로 자기 주장을 내세우며 논박함","answer":"갑론을박"},{"id":"i006","meaning":"고립되어 도움을 받을 데가 없음","answer":"고립무원"},{"id":"i007","meaning":"쓴 것이 다하면 단 것이 온다는 뜻으로, 고생 끝에 즐거움이 옴","answer":"고진감래"},{"id":"i008","meaning":"눈을 비비고 다시 볼 만큼 다른 사람의 학문이나 재주가 크게 향상됨","answer":"괄목상대"},{"id":"i009","meaning":"죽을 고비를 여러 차례 넘기고 겨우 살아남","answer":"구사일생"},{"id":"i010","meaning":"아주 많은 것 가운데 극히 적은 부분","answer":"구우일모"},{"id":"i011","meaning":"평범한 사람들 가운데 매우 뛰어난 한 사람","answer":"군계일학"},{"id":"i012","meaning":"착한 일을 권하고 악한 일을 벌함","answer":"권선징악"},{"id":"i013","meaning":"좋은 일에 또 좋은 일이 더해짐","answer":"금상첨화"},{"id":"i014","meaning":"펄쩍 뛸 만큼 매우 기세가 등등함","answer":"기고만장"},{"id":"i015","meaning":"공격하기 어려워 좀처럼 함락되지 않음","answer":"난공불락"},{"id":"i016","meaning":"두 사람의 능력이나 수준이 비슷하여 우열을 가리기 어려움","answer":"난형난제"},{"id":"i017","meaning":"몹시 마음을 쓰며 애를 태움","answer":"노심초사"},{"id":"i018","meaning":"많으면 많을수록 좋음","answer":"다다익선"},{"id":"i019","meaning":"여러 가지 일도 많고 어려움도 많음","answer":"다사다난"},{"id":"i020","meaning":"큰 인물은 오랜 노력 끝에 늦게 이루어짐","answer":"대기만성"},{"id":"i021","meaning":"괴로움과 즐거움을 함께함","answer":"동고동락"},{"id":"i022","meaning":"물음과 전혀 맞지 않는 엉뚱한 대답","answer":"동문서답"},{"id":"i023","meaning":"같은 처지에 있는 사람끼리 서로 가엾게 여김","answer":"동병상련"},{"id":"i024","meaning":"남의 말을 귀담아듣지 않고 흘려버림","answer":"마이동풍"},{"id":"i025","meaning":"실력이나 수준이 서로 비슷하여 우열을 가리기 어려움","answer":"막상막하"},{"id":"i026","meaning":"이름과 실제가 서로 들어맞음","answer":"명실상부"},{"id":"i027","meaning":"눈앞의 상황이 몹시 참혹하여 차마 볼 수 없음","answer":"목불인견"},{"id":"i028","meaning":"찾아오는 사람이 많아 집 앞이 시장처럼 붐빔","answer":"문전성시"},{"id":"i029","meaning":"먼 앞날까지 내다보고 세우는 큰 계획","answer":"백년대계"},{"id":"i030","meaning":"쏘는 것마다 모두 맞음","answer":"백발백중"},{"id":"i031","meaning":"뚜렷한 자기 생각 없이 남의 의견에 따라 움직임","answer":"부화뇌동"},{"id":"i032","meaning":"분한 마음이 하늘을 찌를 듯이 격렬하게 북받쳐 오름","answer":"분기탱천"},{"id":"i033","meaning":"슬프고 분한 느낌이 마음에 가득 참","answer":"비분강개"},{"id":"i034","meaning":"사방을 둘러보아도 의지할 만한 사람이 없음","answer":"사고무친"},{"id":"i035","meaning":"아무에게도 도움을 받기 어려운 고립된 상황","answer":"사면초가"},{"id":"i036","meaning":"모든 일은 결국 올바른 이치대로 돌아감","answer":"사필귀정"},{"id":"i037","meaning":"인재를 얻기 위해 정성을 다해 여러 번 찾아감","answer":"삼고초려"},{"id":"i038","meaning":"불리할 때는 도망가는 것이 가장 나은 계책이라는 말","answer":"삼십육계"},{"id":"i039","meaning":"세상이 몰라볼 정도로 크게 변함","answer":"상전벽해"},{"id":"i040","meaning":"인생의 길흉화복은 변화가 많아 예측하기 어려움","answer":"새옹지마"},{"id":"i041","meaning":"앞으로 일어날 일을 남보다 먼저 내다보는 지혜","answer":"선견지명"},{"id":"i042","meaning":"어려운 일이 겹쳐 일어남","answer":"설상가상"},{"id":"i043","meaning":"서로 자기 주장을 하며 말이 오고 감","answer":"설왕설래"},{"id":"i044","meaning":"고향이나 근본을 잊지 못함","answer":"수구초심"},{"id":"i045","meaning":"그루터기에 앉아 토끼를 기다린다는 뜻으로, 요행만 바라며 헛되이 기다림","answer":"수주대토"},{"id":"i046","meaning":"입술이 없으면 이가 시리다는 뜻으로, 서로 밀접하게 의지하여 한쪽이 망하면 다른 쪽도 위험함","answer":"순망치한"},{"id":"i047","meaning":"아는 것이 오히려 근심거리가 됨","answer":"식자우환"},{"id":"i048","meaning":"자기 논에 물 대기라는 뜻으로, 자기에게만 이롭게 생각하거나 행동함","answer":"아전인수"},{"id":"i049","meaning":"자기 분수에 만족하며 편안히 지냄","answer":"안분지족"},{"id":"i050","meaning":"남을 업신여기고 자기만 잘난 듯이 행동함","answer":"안하무인"},{"id":"i051","meaning":"말이 이치에 맞지 않음","answer":"어불성설"},{"id":"i052","meaning":"말 속에 날카로운 뜻이나 비판이 담겨 있음","answer":"언중유골"},{"id":"i053","meaning":"상대방의 처지에서 생각해 봄","answer":"역지사지"},{"id":"i054","meaning":"불가능한 일을 하려 함","answer":"연목구어"},{"id":"i055","meaning":"일의 방향이나 상황을 알 수 없어 갈피를 잡지 못함","answer":"오리무중"},{"id":"i056","meaning":"차이는 조금 있지만 본질적으로는 서로 비슷함","answer":"오십보백보"},{"id":"i057","meaning":"옛것을 익히고 그것을 바탕으로 새것을 앎","answer":"온고지신"},{"id":"i058","meaning":"목표를 이루기 위해 괴로움을 참고 견딤","answer":"와신상담"},{"id":"i059","meaning":"겉은 부드러우나 속은 강함","answer":"외유내강"},{"id":"i060","meaning":"변명할 말이 없음","answer":"유구무언"},{"id":"i061","meaning":"미리 준비해 두면 걱정할 일이 없음","answer":"유비무환"},{"id":"i062","meaning":"속세의 번거로움에서 벗어나 여유롭게 지냄","answer":"유유자적"},{"id":"i063","meaning":"여러 사람의 말이 한결같음","answer":"이구동성"},{"id":"i064","meaning":"말하지 않아도 서로 마음이 통함","answer":"이심전심"},{"id":"i065","meaning":"행한 대로 결과나 보답을 받음","answer":"인과응보"},{"id":"i066","meaning":"한 가지 일로 두 가지 이익을 얻음","answer":"일거양득"},{"id":"i067","meaning":"한 가지 일로 두 가지 효과를 얻음","answer":"일석이조"},{"id":"i068","meaning":"날마다 달마다 발전하고 성장함","answer":"일취월장"},{"id":"i069","meaning":"기쁨과 슬픔이 번갈아 일어남","answer":"일희일비"},{"id":"i070","meaning":"자기의 말이나 행동이 앞뒤가 맞지 않음","answer":"자가당착"},{"id":"i071","meaning":"자기가 한 말이나 행동 때문에 스스로 곤란해짐","answer":"자승자박"},{"id":"i072","meaning":"잘못한 사람이 도리어 잘한 사람을 나무람","answer":"적반하장"},{"id":"i073","meaning":"지금까지 아무도 손대거나 발을 디딘 적이 없음","answer":"전인미답"},{"id":"i074","meaning":"몹시 두려워하고 걱정하며 어쩔 줄 몰라 함","answer":"전전긍긍"},{"id":"i075","meaning":"걱정과 근심으로 잠을 이루지 못하고 뒤척임","answer":"전전반측"},{"id":"i076","meaning":"재앙이 바뀌어 오히려 복이 됨","answer":"전화위복"},{"id":"i077","meaning":"몹시 분하게 여기며 이를 갈고 마음을 썩임","answer":"절치부심"},{"id":"i078","meaning":"갈수록 더욱 재미있거나 상황이 더 심해짐","answer":"점입가경"},{"id":"i079","meaning":"눈앞의 차이만 알고 결과가 같은 것을 모르는 어리석음 또는 잔꾀로 남을 속임","answer":"조삼모사"},{"id":"i080","meaning":"불안하여 한곳에 가만히 앉아 있지 못함","answer":"좌불안석"},{"id":"i081","meaning":"여러 사람이 제각기 떠들어 의견이 모이지 않음","answer":"중구난방"},{"id":"i082","meaning":"나아갈 수도 물러설 수도 없는 어려운 처지","answer":"진퇴양난"},{"id":"i083","meaning":"앞으로 나아갈 수도 뒤로 물러설 수도 없는 궁지","answer":"진퇴유곡"},{"id":"i084","meaning":"하늘이 돕는 듯 뜻밖의 큰 도움을 얻음","answer":"천우신조"},{"id":"i085","meaning":"맑은 하늘에 벼락이 치듯 뜻밖에 일어난 큰 사건","answer":"청천벽력"},{"id":"i086","meaning":"제자가 스승보다 더 뛰어남","answer":"청출어람"},{"id":"i087","meaning":"작은 일을 크게 과장하여 말함","answer":"침소봉대"},{"id":"i088","meaning":"실현 가능성이 없는 헛된 이론이나 논의","answer":"탁상공론"},{"id":"i089","meaning":"토끼가 죽으면 사냥개를 삶는다는 뜻으로, 필요할 때 이용하고 목적을 이루면 버림","answer":"토사구팽"},{"id":"i090","meaning":"부모가 돌아가신 뒤 효도하지 못한 것을 한탄함","answer":"풍수지탄"},{"id":"i091","meaning":"겉으로 드러나는 언행과 속으로